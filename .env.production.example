# Copy to /opt/chatai/.env.production on the VPS (chmod 600). Never commit secrets.

# ---------------------------------------------------------------------------
# Public origin (runtime — must match BETTER_AUTH_URL and DNS)
# ---------------------------------------------------------------------------
BETTER_AUTH_URL=https://app.nightzeros.com

# ---------------------------------------------------------------------------
# Database (Neon — external, not on VPS)
# ---------------------------------------------------------------------------
# Pooled URL for app runtime:
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct URL for migrations and workers (recommended):
DATABASE_URL_UNPOOLED=postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional password reset email (Resend)
# RESEND_API_KEY=
# EMAIL_FROM=ChatAI <noreply@nightzeros.com>

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Security + privacy
# ---------------------------------------------------------------------------
# Required once any assistant stores a provider API key:
# ENCRYPTION_KEY=
# ENCRYPTION_KEY_VERSION=1

# Widget rate limits (optional — defaults in apps/web/src/lib/env.ts)
# WIDGET_RATE_LIMIT_PER_VISITOR_PER_MINUTE=20
# WIDGET_RATE_LIMIT_PER_ASSISTANT_PER_MINUTE=120
# WIDGET_SIGNING_MAX_SKEW_SECONDS=300

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads

# ---------------------------------------------------------------------------
# Production deploy (set by docker-compose.prod.yml — do not change)
# ---------------------------------------------------------------------------
# RUN_MIGRATIONS=0

# ---------------------------------------------------------------------------
# Hosted usage metering
# ---------------------------------------------------------------------------
# Default for self-host / copied VPS templates: shadow (meter only, do not 402).
# ChatAI Cloud production MUST set HOSTED_USAGE_ENFORCEMENT=enforce.
HOSTED_USAGE_ENFORCEMENT=shadow
HOSTED_USAGE_DEFAULT_LIMIT_MICROS=1000000

# ---------------------------------------------------------------------------
# Polar billing (optional — omit for self-host / free-tier only)
# ---------------------------------------------------------------------------
# POLAR_SERVER=production
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_PRODUCT_ID_STARTER=
# POLAR_PRODUCT_ID_PRO=
# POLAR_PRODUCT_ID_BUSINESS=

# ---------------------------------------------------------------------------
# Never enable in production
# ---------------------------------------------------------------------------
# SEED_DEMO_ON_START=
