{
  "name": "@chatai/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @chatai/widget build && node ../../scripts/copy-widget.mjs",
    "prebuild": "pnpm --filter @chatai/widget build && node ../../scripts/copy-widget.mjs",
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run prebuild",
    "test": "vitest run"
  },
  "dependencies": {
    "@chatai/ai": "workspace:*",
    "@chatai/database": "workspace:*",
    "@chatai/evals": "workspace:*",
    "@chatai/rag": "workspace:*",
    "@chatai/react": "workspace:*",
    "@chatai/sdk": "workspace:*",
    "@chatai/widget": "workspace:*",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "lucide-react": "^0.483.0",
    "nanoid": "^6.0.1",
    "next": "15.5.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
