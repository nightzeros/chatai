{
  "name": "@nightzeros/chatai-react",
  "version": "1.1.0",
  "description": "React bindings for the ChatAI widget, an open-source project by NightZeros",
  "author": "NightZeros",
  "license": "Apache-2.0",
  "homepage": "https://nightzeros.com/chatai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightzeros/chatai.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/nightzeros/chatai/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:lib": "tsup",
    "test": "vitest run --environment happy-dom",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nightzeros/chatai-widget": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "happy-dom": "^17.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  }
}
