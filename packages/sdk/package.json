{
  "name": "@nightzeros/chatai-sdk",
  "version": "1.1.0",
  "description": "OpenAPI schemas and types for ChatAI, an open-source project by NightZeros",
  "author": "NightZeros",
  "license": "Apache-2.0",
  "homepage": "https://nightzeros.com/chatai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightzeros/chatai.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/nightzeros/chatai/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:lib": "tsup",
    "test": "vitest run",
    "openapi:fingerprint": "UPDATE_OPENAPI_FINGERPRINT=1 vitest run src/openapi.fingerprint.gen.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
