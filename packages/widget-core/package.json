{
  "name": "@nightzeros/chatai-widget-core",
  "version": "1.1.0",
  "description": "Core widget runtime for ChatAI, an open-source project by NightZeros",
  "author": "NightZeros",
  "license": "Apache-2.0",
  "homepage": "https://nightzeros.com/chatai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightzeros/chatai.git",
    "directory": "packages/widget-core"
  },
  "bugs": "https://github.com/nightzeros/chatai/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
