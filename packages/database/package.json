{
  "name": "@chatai/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./rag-settings": "./src/schema/rag-settings.ts",
    "./security-settings": "./src/schema/security-settings.ts",
    "./privacy-settings": "./src/schema/privacy-settings.ts",
    "./voice-settings": "./src/schema/voice-settings.ts",
    "./api-key-scopes": "./src/schema/api-key-scopes.ts",
    "./testing": "./src/testing/pglite.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "migrate:prod": "node scripts/migrate.mjs",
