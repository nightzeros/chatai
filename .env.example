# Copy to .env and fill in values before running the app.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Option A — Neon (recommended for cloud/dev): use the pooled connection string
# from the Neon console for the app, and the direct (non-pooler) URL for migrations.
#
# DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
#
# Option B — Local Docker (self-host / offline):
#   docker compose up -d db
DATABASE_URL=postgresql://chatai:chatai@localhost:5432/chatai
# DATABASE_URL_UNPOOLED=

# Auth (generate with: openssl rand -base64 32)
# BETTER_AUTH_URL must match the public origin browsers use for this ChatAI instance
# (default http://localhost:3000 in apps/web). Widget embeds, data-api-url, and React
# apiUrl should use the same absolute origin (e.g. https://your-chatai-instance.example).
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Optional GitHub OAuth (leave blank to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional email for password reset (Resend). Without RESEND_API_KEY the reset
# link is logged to the server console instead — fine for local/self-host ops.
# RESEND_API_KEY=
# EMAIL_FROM=ChatAI <noreply@yourdomain.com>

# OpenAI-compatible LLM
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# AI_PROVIDER=openai

# Embeddings
# EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional provider API keys (instance-level; per-assistant model overrides in Settings)
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_RESOURCE=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# Offline / local models (Docker Compose profile: local-models)
# ---------------------------------------------------------------------------
# Start Ollama + app + Postgres:
#   docker compose --profile local-models up --build
# Pull chat model once:
#   docker compose --profile local-models exec ollama ollama pull llama3.2
#
# Recommended hybrid (Ollama chat + 1536-d embeddings — matches chunks.embedding):
# AI_PROVIDER=ollama
# AI_MODEL=llama3.2
# OLLAMA_BASE_URL=http://ollama:11434/v1
# AI_API_KEY=sk-...   # still required for default OpenAI embeddings
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
#
# From the host (pnpm dev + local Ollama), use http://127.0.0.1:11434/v1 for OLLAMA_BASE_URL.
#
# Fully local nomic-embed-text (768-d) is NOT compatible with vector(1536) yet — ingest fails.
# See docs: Self-hosting → Local models (Ollama).

# Optional Cohere reranking (when set, used before LLM listwise fallback)
# COHERE_API_KEY=

# Per-API-key REST rate limit (Postgres; widget chat is not rate-limited here)
# API_RATE_LIMIT_PER_MINUTE=60

# Local file uploads (relative to apps/web or absolute; Docker uses /app/uploads)
UPLOAD_DIR=./uploads

# ---------------------------------------------------------------------------
# Demo seed (dev / demo only — never enable in production)
# ---------------------------------------------------------------------------
# After migrations + health, Docker entrypoint can seed demo@chatai.local:
#   SEED_DEMO_ON_START=1
# Idempotent (skips when demo user / Support Bot / refund doc already exist).
# Prefer `pnpm seed:demo` against a running instance for local development.
# SEED_DEMO_ON_START=
# SEED_DEMO_EMAIL=demo@chatai.local
# SEED_DEMO_PASSWORD=DemoPass123!

# ---------------------------------------------------------------------------
# Playwright e2e (defaults match CI; override locally as needed)
# ---------------------------------------------------------------------------
# Generated/refreshed by: pnpm e2e:seed  (writes .env.e2e — do not commit)
# E2E_EMAIL=e2e@chatai.local
# E2E_PASSWORD=E2ePass123!
# E2E_ASSISTANT_ID=asst_e2e_v02
# E2E_BASE_URL=http://127.0.0.1:3000
