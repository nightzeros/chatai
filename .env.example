# Copy to .env and fill in values before running the app.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Option A — Neon (recommended for cloud/dev): use the pooled connection string
# from the Neon console for the app, and the direct (non-pooler) URL for migrations.
# Both must be the SAME endpoint/branch (ep-xxx-pooler vs ep-xxx): migrations and the
# ingest/eval workers use DATABASE_URL_UNPOOLED, so a URL from another branch splits data.
# Migrations refuse to run on a Neon endpoint mismatch.
#
# DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
#
# Option B — Local Docker (self-host / offline):
#   docker compose up -d db
DATABASE_URL=postgresql://chatai:chatai@localhost:5432/chatai
# DATABASE_URL_UNPOOLED=

# Auth (generate with: openssl rand -base64 32)
# BETTER_AUTH_URL must match the public origin browsers use for this ChatAI instance
# (default http://localhost:3000 in apps/web). Widget embeds, data-api-url, and React
# apiUrl should use the same absolute origin (e.g. https://your-chatai-instance.example).
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Optional GitHub OAuth (leave blank to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional email for password reset (Resend). Without RESEND_API_KEY the reset
# link is logged to the server console instead — fine for local/self-host ops.
# RESEND_API_KEY=
# EMAIL_FROM=ChatAI <noreply@yourdomain.com>

# OpenAI-compatible LLM
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# AI_PROVIDER=openai

# Embeddings
# EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional provider API keys (instance-level; per-assistant model overrides in Settings)
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_RESOURCE=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# Offline / local models (Docker Compose profile: local-models)
# ---------------------------------------------------------------------------
# Start Ollama + app + Postgres:
#   docker compose --profile local-models up --build
# Pull chat model once:
#   docker compose --profile local-models exec ollama ollama pull llama3.2
#
# Recommended hybrid (Ollama chat + 1536-d embeddings — matches chunks.embedding):
# AI_PROVIDER=ollama
# AI_MODEL=llama3.2
# OLLAMA_BASE_URL=http://ollama:11434/v1
# AI_API_KEY=sk-...   # still required for default OpenAI embeddings
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
#
# From the host (pnpm dev + local Ollama), use http://127.0.0.1:11434/v1 for OLLAMA_BASE_URL.
#
# Fully local nomic-embed-text (768-d) is NOT compatible with vector(1536) yet — ingest fails.
# See docs: Self-hosting → Local models (Ollama).

# Optional Cohere reranking (when set, used before LLM listwise fallback)
# COHERE_API_KEY=

# Per-API-key REST rate limit (Postgres; widget chat uses WIDGET_* limits below)
# API_RATE_LIMIT_PER_MINUTE=60

# Assistant scope enforcement
# Selective output scope check on risky turns (default true).
# OUTPUT_SCOPE_CHECK=true
# Assistant Profile page (Purpose + owner-reviewed Key facts) and refresh worker (default true; needs migration 0020).
# ASSISTANT_PROFILE=true
# Answer basic contact/hours/identity questions from Key facts without retrieval (default false; evaluation-gated).
# PROFILE_ANSWER_ROUTE=false

# ---------------------------------------------------------------------------
# v0.8 Security + privacy
# ---------------------------------------------------------------------------
# AES-256-GCM key for per-assistant provider secrets (32 bytes).
# Generate: openssl rand -base64 32   OR   openssl rand -hex 32
# Prefix optional: base64:... or hex:...
# Required once any assistant stores a provider API key.
# ENCRYPTION_KEY=
# Optional rotation: bump ENCRYPTION_KEY_VERSION, set ENCRYPTION_KEY to the new key,
# and keep the old material as ENCRYPTION_KEY_PREVIOUS (+ PREVIOUS_VERSION) until re-encrypted.
# ENCRYPTION_KEY_VERSION=1
# ENCRYPTION_KEY_PREVIOUS=
# ENCRYPTION_KEY_PREVIOUS_VERSION=1

# Widget public-chat rate limits (Postgres buckets; override per assistant in Security settings)
# WIDGET_RATE_LIMIT_PER_VISITOR_PER_MINUTE=20
# WIDGET_RATE_LIMIT_PER_ASSISTANT_PER_MINUTE=120
# WIDGET_SIGNING_MAX_SKEW_SECONDS=300

# Hosted usage safety ceiling (micro-dollars; $1 = 1_000_000). Prefer plan_entitlements /
# hosting_accounts.limit_override_micros; this env is the runtime fallback only.
# HOSTED_USAGE_DEFAULT_LIMIT_MICROS=1000000
# shadow = meter without blocking | enforce = hard limits | off = no metering writes
# Production hosted SaaS: HOSTED_USAGE_ENFORCEMENT=enforce
# HOSTED_USAGE_ENFORCEMENT=shadow
# HOSTED_USAGE_MAX_OUTPUT_TOKENS=4096
# HOSTED_USAGE_RECONCILE_STALE_MINUTES=15
# HOSTED_USAGE_EXEMPT_PLAYGROUND=false
# Comma-separated Better Auth user IDs for /api/admin/* (empty = no admins)
# ADMIN_USER_IDS=

# Polar billing (optional; without these, checkout/portal return 503 and the app stays free-tier)
# POLAR_ACCESS_TOKEN=polar_oat_...
# POLAR_WEBHOOK_SECRET=polar_whs_...
# POLAR_SERVER=sandbox
# Allowlisted Product IDs — server maps planCode → product (never trust client product IDs)
# POLAR_PRODUCT_ID_STARTER=...
# POLAR_PRODUCT_ID_PRO=...
# POLAR_PRODUCT_ID_BUSINESS=...
# Deprecated: maps to Business if POLAR_PRODUCT_ID_BUSINESS is unset
# POLAR_PRODUCT_ID_TEAM=...

# Local file uploads (relative to apps/web or absolute; Docker uses /app/uploads)
UPLOAD_DIR=./uploads

# ---------------------------------------------------------------------------
# Voice (preview — not enabled in the public widget yet)
# ---------------------------------------------------------------------------
# Realtime provider for POST /api/v1/voice/sessions. `mock` runs without
# OpenAI credentials (CI / local tests).
# VOICE_PROVIDER=gpt-live
# GPT-Live credentials are resolved independently of AI_PROVIDER and of each
# assistant's text provider (an Anthropic/Gemini assistant can still use
# GPT-Live for Voice). Server-side only; never exposed to browsers.
# VOICE_OPENAI_API_KEY=sk-...
# VOICE_OPENAI_BASE_URL=https://api.openai.com
# Voice runtime state is process-local: run a single web instance (or sticky
# sessions keyed by voice session id) while Voice is in preview.
# Voice minutes follow HOSTED_USAGE_ENFORCEMENT (off | shadow | enforce).
# Owner playground Voice is always measured; when true it is not counted
# toward the account's Voice-minute quota (default true).
# VOICE_QUOTA_EXEMPT_PLAYGROUND=true
# Instance-wide cap on concurrent Voice sessions (protects the provider
# organization's concurrent-session limit). Unset = plan limits only.
# VOICE_MAX_CONCURRENT_SESSIONS=
# Seconds of visitor silence before the assistant checks in; the call ends 30 s
# later. 0 disables idle ending (the 60-minute cap still applies). Default 180.
# VOICE_IDLE_TIMEOUT_SECONDS=180
# Graceful Voice drain on SIGTERM/SIGINT (ms). Live calls are ended with provider-final
# usage and their recordings finalized within this bound; then the process exits.
# Requires NEXT_MANUAL_SIG_HANDLE=1 (set in the Docker image) and a platform stop
# grace at least ~7 s longer (>= 15 s for the default). Default 8000.
# VOICE_SHUTDOWN_GRACE_MS=8000
# NEXT_MANUAL_SIG_HANDLE=1

# Voice audio recording (optional). S3-compatible object storage: AWS S3,
# Cloudflare R2 or self-hosted MinIO. Without a bucket + credentials, recording
# is unavailable and Voice works normally. Recordings are private: owners play
# them back through ChatAI; the bucket is never exposed to browsers.
# OBJECT_STORAGE_BUCKET=chatai-recordings
# OBJECT_STORAGE_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com  MinIO: http://minio:9000
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# MinIO usually needs path-style URLs:
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Local compressed packet spool for in-progress recordings (crash recovery).
# Must be on persistent disk in Docker if partial recordings should survive restarts.
# VOICE_RECORDING_SPOOL_DIR=./.voice-recording-spool
# Log numbers-only recording/provider clock alignment per recorded call (no audio or transcript content).
# VOICE_ALIGNMENT_DIAGNOSTICS=1

# ---------------------------------------------------------------------------
# Demo seed (dev / demo only — never enable in production)
# ---------------------------------------------------------------------------
# After migrations + health, Docker entrypoint can seed demo@chatai.local:
#   SEED_DEMO_ON_START=1
# Idempotent (skips when demo user / Support Bot / refund doc already exist).
# Prefer `pnpm seed:demo` against a running instance for local development.
# SEED_DEMO_ON_START=
# SEED_DEMO_EMAIL=demo@chatai.local
# SEED_DEMO_PASSWORD=DemoPass123!

# ---------------------------------------------------------------------------
# Playwright e2e (defaults match CI; override locally as needed)
# ---------------------------------------------------------------------------
# Generated/refreshed by: pnpm e2e:seed  (writes .env.e2e — do not commit)
# E2E_EMAIL=e2e@chatai.local
# E2E_PASSWORD=E2ePass123!
# E2E_ASSISTANT_ID=asst_e2e_v02
# E2E_BASE_URL=http://127.0.0.1:3000
